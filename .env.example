# GEMINI_API_KEY: Optional. Used for AI digitization features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend Admin Authentication
# Change these in production!
ADMIN_PASSWORD=1234
JWT_SECRET=super-secret-jwt-key-replace-in-production

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
# VITE_SUPABASE_URL: Supabase Project URL
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
# VITE_SUPABASE_ANON_KEY: Supabase Anon Key
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Privileged Supabase Secret Key for server-side Storage and Database administration
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# M-Pesa Daraja Integration Secrets (Server-Side Only - Never prefix with VITE_)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
